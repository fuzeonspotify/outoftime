# Keep repository text files consistent across Windows and other platforms.
* text=auto

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary assets
*.ogg binary
*.wav binary
*.flac binary
*.mp3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.glb binary
*.zip binary
